# Smart Legal Advisor — Environment Configuration
# All services run locally — no cloud API keys needed!

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4
OLLAMA_TIMEOUT=180

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=legal_documents

# Embedding & Reranker Models (downloaded automatically)
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Data paths
DATA_DIR=.\data\legal-ai-dataset
VECTOR_STORE_PATH=./vector_store
BM25_INDEX_PATH=./vector_store/bm25_index.json

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
